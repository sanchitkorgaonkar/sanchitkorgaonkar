---
layout: model.njk
layerPage: true
pagination:
  data: layers
  size: 1
  alias: layer
permalink: "/{{ layer.slug }}/"
eleventyComputed:
  title: "{{ layer.title }}"
  name: "{{ layer.name }}"
  description: "{{ layer.description }}"
---
{%- set up = layers | neighbour(layer.key, -1) -%}
{%- set down = layers | neighbour(layer.key, 1) -%}

<section class="m-sec m-lhead-sec">
  <nav class="m-where" aria-label="The four layers">
    {% for l in layers %}<a href="/{{ l.slug }}/" {% if l.key == layer.key %}aria-current="page"{% endif %}><span class="m-num">{{ l.n }}</span>{{ l.name }}</a>{% endfor %}
  </nav>
  <p class="m-said" data-said hidden>You said: <q>{{ layer.problem }}</q> Here's what I've learned about it.</p>
  <div class="m-lhead">
    <div class="m-lhead-txt">
      <span class="m-eyebrow">Layer {{ layer.n }} of 4 · {{ layer.sub }}</span>
      <h1>{{ layer.title }}</h1>
      <span class="m-status {{ layer.status.tone }}">{{ layer.status.label }}</span>
      <p class="m-lede">{{ layer.lede }}</p>
    </div>
    {% set v = layer.video %}{% set size = "small" %}{% include "partials/video.njk" %}
  </div>
</section>

{%- set caseSteps = [
  ["start", "Starting situation"],
  ["decisions", "Decisions I made"],
  ["redesign", "What I redesigned"],
  ["hard", "What was hard"],
  ["changed", "What changed"],
  ["learned", "What I learned"]
] -%}
<section class="m-sec">
  <h2>How it went</h2>
  <ol class="m-case">
    {% for step in caseSteps %}
    <li class="m-case-step{% if step[0] == 'learned' %} is-learned{% endif %}">
      <span class="m-case-k">{{ step[1] }}</span>
      <div class="m-case-v">
        <p>{{ layer.case[step[0]] }}</p>
        {% if layer.fieldAfter == step[0] %}
        <div class="m-field {% if not layer.field.num %}nonum{% endif %}">
          <span class="m-eyebrow">From the field</span>
          {% if layer.field.num %}<b>{{ layer.field.num }}</b>{% endif %}
          <p>{{ layer.field.text }}</p>
        </div>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ol>
</section>

{% include "partials/interactive.njk" %}

<section class="m-sec">
  <h2>If you're facing this</h2>
  <p class="m-small">What I'd look at first in your organisation.</p>
  <ol class="m-qs">{% for q in layer.questions %}<li>{{ q }}</li>{% endfor %}</ol>
</section>

<section class="m-sec">
  <h2>Go deeper</h2>
  <ol class="m-essays">
    {% for e in series %}{% if e.layer == layer.key %}
    <li>
      <span class="n">{{ e.n | pad2 }}</span>
      <span class="t">{% if e.url %}<a href="{{ e.url }}"><b>{{ e.title }}</b></a>{% else %}<b>{{ e.title }}</b>{% endif %}<span>{{ e.excerpt }}</span></span>
      <span class="s {{ e.status }}">{{ e.status | statusLabel }}</span>
    </li>
    {% endif %}{% endfor %}
  </ol>
  <a class="m-link" href="/how-it-works/">How the four layers work together →</a>
</section>

<section class="m-sec">
  <div class="m-pager">
    {% if up %}<a href="/{{ up.slug }}/"><span class="m-eyebrow">← Previous layer</span><b><span class="m-num">{{ up.n }}</span>{{ up.name }}</b></a>
    {% else %}<a href="/"><span class="m-eyebrow">← Start</span><b>The whole model</b></a>{% endif %}
    {% if down %}<a class="next" href="/{{ down.slug }}/"><span class="m-eyebrow">Next layer →</span><b><span class="m-num">{{ down.n }}</span>{{ down.name }}</b></a>
    {% else %}<a class="next" href="/essays/"><span class="m-eyebrow">Read the series →</span><b>Essays</b></a>{% endif %}
  </div>
</section>
