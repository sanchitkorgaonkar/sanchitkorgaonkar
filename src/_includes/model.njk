{%- set pageTitle = site.name if isHome else ((name or title) + " — " + site.name) -%}
{%- set pageDesc = description or excerpt or site.description -%}
{%- set pageImage = site.url + (ogImage or site.ogImage) -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="{{ 'article' if layout == 'essay.njk' else 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle or pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ pageImage }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/model.css">
  <link rel="icon" type="image/svg+xml" href="/assets/mark.svg">
  <link rel="alternate icon" type="image/png" href="/assets/favicon.png">

  <script>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
  <script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
  {%- set navLinks = [
    ["/", "The model", isHome or layerPage],
    ["/essays/", "Essays", page.url.startsWith('/essays') or page.url.startsWith('/notes')],
    ["/check/", "Self-check", page.url.startsWith('/check')],
    ["/about/", "About", page.url.startsWith('/about')]
  ] -%}
  <a class="m-skip" href="#main">Skip to content</a>
  <header class="m-top">
    <div class="m-top-in">
      <a class="m-brand" href="/">{% include "partials/mark.njk" %}<span class="m-brand-txt"><b>{{ site.name }}</b><span>{{ site.tagline }}</span></span></a>
      <nav class="m-nav" aria-label="Site">
        {% for l in navLinks %}<a href="{{ l[0] }}" {% if l[2] %}aria-current="page"{% endif %}>{{ l[1] }}</a>{% endfor %}
      </nav>
      <a class="m-btn m-top-cta" href="{{ site.linkedin }}" target="_blank" rel="noopener"><span class="long">Connect on </span>LinkedIn</a>
    </div>
  </header>

  <main class="m-wrap" id="main" tabindex="-1">
    {{ content | safe }}

    <section class="m-sec" id="contact">
      <div class="m-closing">
        <h2>Redesigning how your teams work with AI?</h2>
        <p>I'm always up for comparing notes on how work flows, how teams are shaped and how leaders see when AI changes the economics of building.</p>
        <div class="m-row">
          <a class="m-btn primary" href="{{ site.linkedin }}" target="_blank" rel="noopener">Connect on LinkedIn</a>
          <span class="m-or">or email <code id="m-email">{{ site.email }}</code></span>
          <button class="m-linkbtn" type="button" data-copy="#m-email">Copy email</button>
        </div>
      </div>
    </section>
  </main>

  <footer class="m-footer">
    <div class="m-footer-in">
      <a class="m-footer-brand" href="/" aria-label="{{ site.name }}, home">{% include "partials/mark.njk" %}</a>
      <p class="m-signoff">© {{ "now" | year }} {{ site.name }} — Made with curiosity</p>
      <nav class="m-footer-nav" aria-label="Footer">
        {% for l in navLinks %}<a href="{{ l[0] }}">{{ l[1] }}</a>{% endfor %}
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
      </nav>
    </div>
  </footer>

  <script src="/js/model.js" defer></script>
</body>
</html>
