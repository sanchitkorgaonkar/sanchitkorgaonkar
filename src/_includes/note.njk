---
layout: model.njk
---
<section class="m-sec">
  <article class="m-article">
    <a class="m-link" href="/library/">← Library</a>
    <span class="m-eyebrow">Note{% if type %} · {{ type }}{% endif %}{% if year %} · {{ year }}{% endif %}</span>
    <h1>{{ title }}</h1>
    {% if stack %}<p class="m-meta">{{ stack }}</p>{% endif %}
    <div class="m-prose">
      {{ content | safe }}
    </div>
  </article>
</section>
